# PREPARATION ONLY. Do not start with production data until migration approval.
JARVIS_PROFILE=oracle-production
JARVIS_ENV=production
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_ENABLE_EXTERNAL_ACCESS=false
JARVIS_PUBLIC_ORIGIN=https://jarvis.example.org
JARVIS_COOKIE_SECURE=true
JARVIS_DATABASE_PATH=/var/lib/jarvis/jarvis.sqlite3
JARVIS_RUNTIME_DIR=/run/jarvis
JARVIS_LOG_PATH=/var/log/jarvis/server.log
JARVIS_AUTOMATIONS_ENABLED=false
JARVIS_VAULT_KEY_FILE=/var/lib/jarvis/secrets/vault.key
JARVIS_GOOGLE_CLIENT_FILE=/var/lib/jarvis/secrets/google-client.json
ELEVENLABS_API_KEY_FILE=/var/lib/jarvis/secrets/elevenlabs.key
ELEVENLABS_VOICE_ID=
JARVIS_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
JARVIS_MAX_CONCURRENT_AI=1
JARVIS_MAX_CONTEXT_CHARS=12000
JARVIS_MAX_OUTPUT_TOKENS=384
JARVIS_MODELS_DIR=/var/lib/jarvis/models
JARVIS_FORCE_CPU=true
OMP_NUM_THREADS=2
