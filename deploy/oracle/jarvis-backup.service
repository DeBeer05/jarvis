[Unit]
Description=Consistent encrypted JARVIS backup
After=jarvis.service

[Service]
Type=oneshot
UMask=0077
TimeoutStartSec=300
ExecStart=/opt/jarvis/current/.venv/bin/python /opt/jarvis/current/scripts/server_backup.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# SQLite may need its WAL shared-memory sidecar during a read-only snapshot.
ReadWritePaths=/var/lib/jarvis
