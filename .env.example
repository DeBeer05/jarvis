# Headless server; kopieer desgewenst naar .env. Nooit echte secrets committen.
# Alleen de nieuwe server leest dit; de bestaande desktopapp blijft ongewijzigd.
JARVIS_PHASE=3
JARVIS_ENV=development
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_LOG_LEVEL=info
JARVIS_LOG_PATH=.local/logs/server.log
JARVIS_LOG_MAX_BYTES=1048576
JARVIS_LOG_BACKUP_COUNT=3
JARVIS_DATABASE_PATH=.local/data/jarvis.sqlite3
JARVIS_RUNTIME_DIR=.local/run
JARVIS_ENABLE_EXTERNAL_ACCESS=false
JARVIS_ENABLE_AUTOMATIONS=false
JARVIS_PROFILE=desktop-development
JARVIS_AI_PROVIDER=auto
JARVIS_AI_PREFERRED_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Groq Free Plan heeft gebruikslimieten; account/sleutel zelf lokaal instellen.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
JARVIS_SYSTEM_PROMPT_FILE=config/jarvis-system-prompt.txt
JARVIS_AI_TIMEOUT_SECONDS=60
JARVIS_PROVIDER_TIMEOUT_SECONDS=25
JARVIS_AI_MAX_CONCURRENT=2
JARVIS_CHAT_MAX_MESSAGE_CHARS=8000
JARVIS_AI_MAX_CONTEXT_CHARS=24000
JARVIS_AI_MAX_OUTPUT_TOKENS=1024
JARVIS_CHAT_MAX_RESPONSE_CHARS=16000
JARVIS_CHAT_REQUESTS_PER_MINUTE=30
JARVIS_CHAT_MAX_CONVERSATIONS=100
JARVIS_CHAT_MAX_TURNS=100

# Authentication is always enabled; local HTTP only, HTTPS cookies become Secure.
JARVIS_ACCESS_SECONDS=300
JARVIS_REFRESH_SECONDS=604800
JARVIS_SESSION_SECONDS=604800
JARVIS_DESKTOP_SESSION_SECONDS=2592000
JARVIS_PAIRING_SECONDS=300
JARVIS_PAIRING_POLL_SECONDS=5
JARVIS_LOGIN_MAX_ATTEMPTS=5
JARVIS_LOGIN_WINDOW_SECONDS=300
JARVIS_AUTH_REQUESTS_PER_MINUTE=60
JARVIS_AUDIT_RETENTION_DAYS=30
JARVIS_AUDIT_MAX_ENTRIES=10000
JARVIS_MAX_DEVICES=20
JARVIS_MAX_SESSIONS=20
JARVIS_PASSWORD_REVOKE_ALL=true
JARVIS_COOKIE_SECURE=auto
JARVIS_TRUSTED_HOSTS=127.0.0.1,localhost
JARVIS_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
